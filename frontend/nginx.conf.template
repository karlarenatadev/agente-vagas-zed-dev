# Proxy reverso + SPA. Renderizado pelo entrypoint do Nginx (envsubst) em
# /etc/nginx/conf.d/default.conf. Apenas ${BACKEND_UPSTREAM} é substituído.

# Mapeia o header Upgrade para o valor correto de Connection (WebSocket).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS embutido do Docker. Resolver o upstream em runtime (e não no load do
    # config) evita falha de boot quando o backend/mock sobe depois do Nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API REST. O header X-Session-Id é repassado automaticamente.
    location /api/ {
        set $upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # WebSocket do chat (streaming). Timeout alto para conexões longas.
    location /ws/ {
        set $upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA: rotas do cliente caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
