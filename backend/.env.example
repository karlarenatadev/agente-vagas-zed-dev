# Copy this file to backend/.env and fill local values there.
# Never commit real API keys.

# Required API keys
OPENAI_API_KEY=replace-with-openai-api-key
FIRECRAWL_API_KEY=replace-with-firecrawl-api-key

# Local project paths
DATA_DIR=../data
PERSONAS_DIR=../personas
SKILLS_DIR=../skills

# LLM model
LLM_MODEL=gpt-4o-mini
# Optional: base URL of an OpenAI-compatible provider (e.g. OpenRouter).
# Leave empty to use the default OpenAI endpoint (https://api.openai.com/v1).
# Example for OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=../logs
LOG_FILE=../logs/backend.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
